# NomadPacket — environment variables
# Copy to .env.local for local dev. Never commit real secrets.
# Keep this file current whenever a new env var is introduced (AGENTS.md §4).

# --- Site ---
# Canonical site URL. Used in magic-link emails, canonical links, webhook return
# URLs, etc. Never hardcode nomadpacket.app anywhere else in the codebase.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Dev tunnel (ngrok) ---
# Off by default — plain localhost dev needs none of this. Turn on only
# while testing through an ngrok tunnel (e.g. so Dodo Payments webhooks,
# which are server-to-server and can't reach localhost, have somewhere to
# land). See next.config.ts (allowedDevOrigins / serverActions.allowedOrigins)
# for what this actually gates. When on, also point NEXT_PUBLIC_SITE_URL,
# AUTH_URL, and the Dodo webhook endpoint at your current ngrok URL —
# ngrok's free tier issues a new one every restart, so all of these need
# updating together each session.
# DEV_TUNNEL_ENABLED="true"
# AUTH_URL="https://your-current-tunnel-id.ngrok-free.app"

# --- Database (Postgres via Prisma) ---
DATABASE_URL="postgresql://user:password@localhost:5432/nomadpacket?schema=public"

# --- Auth: qualifier-gate cookie signing (unrelated to sign-in itself) ---
# Used to sign the short-lived gate-context cookie between /start and
# /signin. Generate with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-string"

# --- Auth: Google sign-in (Auth.js v5) ---
# Magic-link email auth is dormant (per-send Resend cost, not worth it pre-
# revenue) — Google is the only active sign-in method. Create OAuth
# credentials at https://console.cloud.google.com/apis/credentials
# (Web application type). Authorized redirect URI:
#   {NEXT_PUBLIC_SITE_URL}/api/auth/callback/google
# AUTH_SECRET generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_GOOGLE_ID="xxxxxxxxxxxx.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx"
# Set to "true" if deploying somewhere other than Vercel (Vercel sets this
# automatically) — Auth.js otherwise refuses to trust the request Host
# header, as a CSRF-adjacent protection.
# AUTH_TRUST_HOST="true"

# --- Email (Resend) ---
# Used for magic-link sign-in emails and the packet-ready delivery email.
# Free plan: 100/day, 3,000/month — both paths are rate-limited server-side
# (lib/rate-limit.ts) to stay well under that even under abuse.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="hello@nomadpacket.app"

# --- Payments (Dodo Payments) ---
# API key: Dashboard > Developer > API Keys.
DODO_PAYMENTS_API_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Webhook signing secret: Dashboard > Developer > Webhooks > (create an
# endpoint pointed at {NEXT_PUBLIC_SITE_URL}/api/webhooks/dodo) > copy its
# signing secret. entitlement/dodo-client.ts and the webhook route both
# read this to verify requests actually came from Dodo.
DODO_PAYMENTS_WEBHOOK_KEY="whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# "test_mode" | "live_mode" — matches which dashboard mode DODO_PAYMENTS_API_KEY
# and DODO_PRODUCT_ID were created under; the two must be from the same mode.
DODO_PAYMENTS_ENVIRONMENT="test_mode"
# Dashboard > Products > create a one-time product for the D8 packet, set
# its price/currency there (that's the actual source of truth for what
# gets charged — DODO_PRODUCT_PRICE_CENTS/CURRENCY below are for reference/
# display only, not passed to Dodo at checkout time). Copy its product id.
DODO_PRODUCT_ID="pdt_xxxxxxxxxxxxxxxxxxxxxxxx"
DODO_PRODUCT_PRICE_CENTS="0"
DODO_PRODUCT_CURRENCY="USD"

# --- Storage (Vercel Blob) ---
# Generated documents (letters, income summary, form pre-fill) are stored
# via lib/storage.ts. Vercel injects this automatically once a Blob store
# is attached to the project — leave unset locally to fall back to the
# local filesystem (.data/documents) for dev/test.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# --- Retention cron (app/api/cron/delete-expired-documents) ---
# Secures the daily document-retention sweep (vercel.json). Generate with:
# openssl rand -base64 32 — then also add it as a Vercel env var so Vercel
# sends it as the cron request's Authorization header automatically.
# Requests are rejected if this is unset (fail closed).
# CRON_SECRET="replace-with-a-long-random-string"

# --- SEO (see seo.md) ---
# Optional. Set once you verify the domain in Google Search Console
# (Settings > Ownership verification > HTML tag > just the content value,
# not the full <meta> tag). Leave unset until Search Console is configured.
GOOGLE_SITE_VERIFICATION=""
