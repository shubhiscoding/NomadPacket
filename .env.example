# NomadPacket — environment variables
# Copy to .env.local for local dev. Never commit real secrets.
# Keep this file current whenever a new env var is introduced (AGENTS.md §4).

# --- Site ---
# Canonical site URL. Used in magic-link emails, canonical links, webhook return
# URLs, etc. Never hardcode nomadpacket.com anywhere else in the codebase.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Database (Postgres via Prisma) ---
DATABASE_URL="postgresql://user:password@localhost:5432/nomadpacket?schema=public"

# --- Auth (magic link) ---
# Used to hash/sign session + magic-link tokens server-side. Generate with:
#   openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-string"

# --- Email (Resend) ---
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="hello@nomadpacket.com"

# --- Payments (Dodo Payments) ---
DODO_PAYMENTS_API_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
DODO_PAYMENTS_WEBHOOK_KEY="whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# "test_mode" | "live_mode"
DODO_PAYMENTS_ENVIRONMENT="test_mode"
# Flat-price SKU for the v1 Portugal D8 packet, in minor units (cents). No price
# is specified in the product spec — this is a business decision, not invented
# here; set the real value before launch.
DODO_PRODUCT_PRICE_CENTS="0"
DODO_PRODUCT_CURRENCY="USD"

# --- SEO (see seo.md) ---
# Optional. Set once you verify the domain in Google Search Console
# (Settings > Ownership verification > HTML tag > just the content value,
# not the full <meta> tag). Leave unset until Search Console is configured.
GOOGLE_SITE_VERIFICATION=""
